---
import { Image } from 'astro:assets';
import treatingPatientImage from '../assets/treatments/treating-patient.jpg';
import sterImage from '../assets/treatments/ster.jpg';
import wtarepurifImage from '../assets/treatments/wtarepurif.webp';
import xrayImage from '../assets/treatments/xray.jpg';
import dentalImage from '../assets/treatments/dental.jpg';
import toolsImage from '../assets/treatments/tools.jpg';
import patient1Image from '../assets/patients/patient1.jpg';
import patient2Image from '../assets/patients/patient2.jpg';
import patient3Image from '../assets/patients/patient3.jpg';
import patient4Image from '../assets/patients/patient4.jpg';
import patient5Image from '../assets/patients/patient5.jpg';
import patient6Image from '../assets/patients/patient6.jpg';
import patient7Image from '../assets/patients/patient7.jpg';
import patient8Image from '../assets/patients/patient8.jpg';
import patient9Image from '../assets/patients/patient9.jpg';
import patient10Image from '../assets/patients/patient10.jpg';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const clinicImages = [
  { src: treatingPatientImage, title: "Patient Treatment Studio", category: "Facility" },
  { src: sterImage, title: "Class-B Autoclave Sterilizer", category: "Sterilization" },
  { src: wtarepurifImage, title: "Closed-Loop Pure Water Unit", category: "Technology" },
  { src: xrayImage, title: "Digital X-Ray Diagnoses", category: "Technology" },
  { src: dentalImage, title: "Dental Operatory", category: "Facility" },
  { src: toolsImage, title: "Endodontic Rotary Instruments", category: "Equipment" }
];

const patientPhotos = [
  patient1Image,
  patient2Image,
  patient3Image,
  patient4Image,
  patient5Image,
  patient6Image,
  patient7Image,
  patient8Image,
  patient9Image,
  patient10Image
];
---

<Layout breadcrumbs={[{ name: "Gallery", path: "/gallery/" }]}
  title="Clinic Gallery | One Smile Dental Care"
  description="Take a visual tour of One Smile Dental Care. See our sterile operatory, advanced dental equipment, water purification setups, and beautiful patient results."
>
  <nav class="bg-white border-b border-stone-200 py-8" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-2">
      <ol class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-stone-500">
        <li>
          <a href={base} class="hover:text-teal-600 transition-colors">Home</a>
        </li>
        <li class="flex items-center gap-2 text-stone-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-teal-600">Gallery</span>
        </li>
      </ol>
      <h1 class="text-3xl font-extrabold text-stone-900 mt-2">Clinic & Results Gallery</h1>
    </div>
  </nav>

  {/* Clinic Facility Gallery */}
  <section class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-teal-600">The Studio</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 mt-2 mb-4">Our Facilities & Technology</h2>
        <p class="text-base text-stone-600">
          We maintain strict sterilization standards and clinical technologies for maximum safety and comfort.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {clinicImages.map(img => (
          <div class="group relative overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all duration-300 hover:shadow-md">
            <div class="aspect-video w-full overflow-hidden bg-stone-100 relative">
              <Image
                src={img.src}
                alt={img.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
                loading="lazy"
 sizes="(max-width: 768px) 100vw, 50vw" format="webp" widths={[160, 480, 960, 1440]} />
              <div class="absolute top-4 left-4 bg-stone-950/80 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-teal-400 border border-stone-850">
                {img.category}
              </div>
            </div>
            <div class="p-5">
              <h3 class="font-bold text-stone-900 text-base">{img.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Patient Smile Gallery */}
  <section class="py-20 bg-stone-100 border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-teal-600">Happy Patients</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 mt-2 mb-4">Smile Transformations</h2>
        <p class="text-base text-stone-600">
          Actual results showcasing corrected teeth alignments, smile makeovers, and successful dental implants.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        {patientPhotos.map((photo, idx) => (
          <div class="group relative overflow-hidden rounded-xl border border-stone-200 shadow-sm aspect-square bg-white">
            <Image
              src={photo}
              alt={`One Smile patient transformation ${idx + 1}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
 sizes="(max-width: 768px) 100vw, 50vw" format="webp" widths={[160, 480, 960, 1440]} />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <span class="text-xs text-white font-semibold">Smile Design #{idx + 1}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
